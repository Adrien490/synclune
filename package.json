{
	"name": "synclune-bijoux",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": ">=22.22.1",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "prisma generate && next build --turbopack",
		"start": "next start",
		"lint": "eslint --max-warnings=0",
		"seed": "prisma db seed",
		"email:dev": "email dev --dir emails --port 3001",
		"db:studio": "prisma studio",
		"analyse": "next experimental-analyse",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:critical": "vitest run modules/cart modules/orders modules/payments modules/webhooks modules/admin-auth app/api/webhooks/stripe test/contract",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"test:pre-commit": "pnpm test:critical",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"size": "size-limit",
		"size:check": "size-limit --json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"prepare": "husky",
		"clean": "rm -rf .next node_modules/.cache coverage test-results playwright-report",
		"generate:brand-icons": "tsx scripts/generate-brand-icons.ts",
		"docs:stripe": "tsx scripts/fetch-stripe-docs.ts",
		"db:reset": "prisma migrate reset && pnpm seed",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
		"validate": "pnpm lint && pnpm typecheck && pnpm format:check && vitest run",
		"knip": "knip",
		"doctor:check": "react-doctor . --offline -y",
		"doctor:full": "react-doctor . --offline -y --full --verbose"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,mdx,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/adapter-neon": "^7.9.0",
		"@prisma/client": "7.9.1",
		"@prisma/sqlcommenter-trace-context": "^7.9.0",
		"@radix-ui/react-focus-scope": "^1.1.16",
		"@sentry/nextjs": "^10.68.0",
		"@tanstack/react-form": "^1.33.2",
		"@tanstack/react-form-nextjs": "^1.33.2",
		"@uploadthing/react": "^7.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"heic-to": "^1.5.2",
		"libphonenumber-js": "^1.13.9",
		"motion": "^12.42.2",
		"next": "16.3.0",
		"pino": "^10.3.1",
		"react": "19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.2.8",
		"react-email": "^6.9.1",
		"react-phone-number-input": "^3.4.17",
		"resend": "^6.18.0",
		"sharp": "^0.35.3",
		"sonner": "^2.0.7",
		"stripe": "^22.3.2",
		"tailwind-merge": "^3.6.0",
		"thumbhash": "^0.1.1",
		"uploadthing": "^7.7.4",
		"yet-another-react-lightbox": "^3.32.1",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@playwright/test": "^1.62.0",
		"@prisma/adapter-pg": "^7.9.0",
		"@react-email/render": "^2.1.0",
		"@size-limit/file": "^13.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.10",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.3.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.0",
		"knip": "^6.29.0",
		"lint-staged": "^17.2.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^7.9.0",
		"react-doctor": "^0.9.2",
		"size-limit": "^13.0.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"sharp": "$sharp"
		},
		"onlyBuiltDependencies": [
			"sharp",
			"@prisma/client",
			"prisma",
			"@sentry/cli",
			"@prisma/engines"
		]
	}
}
