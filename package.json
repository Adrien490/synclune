		"nanoid": "^5.1.11",
		"next": "16.2.9",
		"pino": "^10.3.1",
		"react": "19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.2.7",
		"react-email": "^6.6.3",
		"react-phone-number-input": "^3.4.17",
		"recharts": "3.8.1",
		"resend": "^6.14.0",
		"serwist": "^9.5.11",
		"sharp": "^0.35.1",
		"sonner": "^2.0.7",
		"stripe": "^22.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"thumbhash": "^0.1.1",
		"uploadthing": "^7.7.4",
		"vaul": "^1.1.2",
		"yet-another-react-lightbox": "^3.32.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@better-auth/cli": "^1.4.21",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@commitlint/types": "^21.0.1",
		"@faker-js/faker": "^10.5.0",
		"@playwright/test": "^1.61.0",
		"@prisma/adapter-neon": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@react-email/render": "^2.0.9",
		"@react-email/ui": "^6.6.3",
		"@size-limit/file": "^12.1.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/color": "^4.2.1",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.9",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.4.2",
		"embla-carousel": "^8.6.0",
		"esbuild": "^0.28.1",
		"esbuild-wasm": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-config-next": "16.2.9",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"knip": "^6.17.1",
		"lint-staged": "^17.0.7",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^7.8.0",
		"size-limit": "^12.1.0",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"vitest-axe": "^0.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"@prisma/client",
			"prisma",
			"@sentry/cli",
			"@prisma/engines"
		]
	}
}
