{
	"name": "synclune-bijoux",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": ">=22.22.1",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "prisma generate && next build --turbopack",
		"start": "next start",
		"lint": "eslint --max-warnings=0",
		"seed": "prisma db seed",
		"email:dev": "email dev --dir emails --port 3001",
		"db:studio": "prisma studio",
		"analyse": "next experimental-analyse",
		"lighthouse:desktop": "pnpm dlx @lhci/cli@0.15.x autorun --config=lighthouserc.json",
		"lighthouse:mobile": "pnpm dlx @lhci/cli@0.15.x autorun --config=lighthouserc.mobile.json",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:critical": "vitest run modules/cart modules/orders modules/payments modules/webhooks modules/auth modules/discounts modules/refunds modules/invoices app/api/webhooks/stripe test/contract",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"test:pre-commit": "pnpm test:critical",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"size": "size-limit",
		"size:check": "size-limit --json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"prepare": "husky",
		"clean": "rm -rf .next node_modules/.cache coverage test-results playwright-report",
		"generate:video-thumbnails": "tsx scripts/generate-video-thumbnails.ts",
		"db:reset": "prisma migrate reset && pnpm seed",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
		"validate": "pnpm lint && pnpm typecheck && pnpm format:check && vitest run",
		"knip": "knip",
		"doctor": "react-doctor . --offline -y",
		"doctor:full": "react-doctor . --offline -y --full --verbose"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,mdx,yml,yaml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@better-auth/stripe": "^1.6.19",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@prisma/sqlcommenter-trace-context": "^7.8.0",
