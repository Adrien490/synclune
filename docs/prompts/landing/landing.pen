                          "name": "titre",
                          "fill": "$encre",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Chaque bijou passe entre mes mains",
                          "lineHeight": "$leading-h2",
                          "fontFamily": "$font-display",
                          "fontSize": "$text-h2",
                          "fontWeight": "$graisse-display",
                          "letterSpacing": "$tracking-h2"
                        },
                        {
                          "type": "text",
                          "id": "btfM0",
                          "name": "chapô",
                          "fill": "$encre",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Je m'appelle Léane. Je peins et j'assemble chaque pièce dans mon atelier, à Nantes. Et si tu m'écris : c'est moi qui lis, c'est moi qui réponds.",
                          "lineHeight": "$leading-body",
                          "fontFamily": "$font-sans",
                          "fontSize": "$text-body",
                          "fontWeight": "$graisse-normale"
                        }
                      ]
