generator client {
  provider      = "prisma-client"
  output        = "../app/generated/prisma"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ANONYMIZED
}

model User {
  id            String    @id @default(cuid(2))
  role          Role      @default(USER)
  name          String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(2048)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  suspendedAt   DateTime?

  accountStatus AccountStatus @default(ACTIVE)

  sessions Session[]
  accounts Account[]
  orders   Order[]

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   User_email_lower_key
  //   User_email_lowercase
  //   User_email_unaccent_trgm_idx
  //   User_name_unaccent_trgm_idx
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId, expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.VarChar(500)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ProductStatus {
  DRAFT
  PUBLIC
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  PUBLIC
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum HistorySource {
  ADMIN
  WEBHOOK
  SYSTEM
  CUSTOMER
}

model ProductType {
  id          String  @id @default(cuid(2))
  slug        String  @unique @db.VarChar(100)
  label       String  @unique @db.VarChar(50)
  description String? @db.Text
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Color {
  id          String            @id @default(cuid(2))
  slug        String            @unique @db.VarChar(100)
  name        String            @unique @db.VarChar(100)
  hex         String            @db.VarChar(7)
  description String?           @db.Text
  isActive    Boolean           @default(true)
  skuColors   ProductSkuColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Material {
  id           String               @id @default(cuid(2))
  slug         String               @unique @db.VarChar(100)
  name         String               @unique @db.VarChar(100)
  description  String?              @db.Text
  isActive     Boolean              @default(true)
  skuMaterials ProductSkuMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ProductSkuColor {
  id      String     @id @default(cuid(2))
  skuId   String
  sku     ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  colorId String
  color   Color      @relation(fields: [colorId], references: [id], onDelete: Restrict)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, colorId])
  @@index([colorId])
  @@index([skuId, position])
}

model ProductSkuMaterial {
  id         String     @id @default(cuid(2))
  skuId      String
  sku        ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  materialId String
  material   Material   @relation(fields: [materialId], references: [id], onDelete: Restrict)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, materialId])
  @@index([materialId])
  @@index([skuId, position])
}

model Collection {
  id          String           @id @default(cuid(2))
  name        String           @unique @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.Text
  status      CollectionStatus @default(DRAFT)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductCollection[]

  @@index([status])
}

model ProductCollection {
  id           String     @id @default(cuid(2))
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   ProductCollection_collectionId_isFeatured_unique

  @@unique([productId, collectionId])
  @@index([collectionId])
}

model Product {
  id          String        @id @default(cuid(2))
  slug        String        @unique @db.VarChar(100)
  title       String        @db.VarChar(200)
  description String?       @db.Text
  status      ProductStatus @default(PUBLIC)

  type   ProductType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeId String?

  collections ProductCollection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  skus       ProductSku[]
  orderItems OrderItem[]

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   Product_description_unaccent_trgm_idx
  //   Product_title_unaccent_trgm_idx

  @@index([typeId])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, deletedAt])
}

model ProductSku {
  id        String  @id @default(cuid(2))
  sku       String  @unique @db.VarChar(100)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  colors ProductSkuColor[]

  materials ProductSkuMaterial[]

  size String? @db.VarChar(50)

  priceInclTax   Int
  compareAtPrice Int?
  inventory      Int     @default(0)
  isActive       Boolean @default(true)

  isDefault Boolean @default(false)

  images         SkuMedia[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   ProductSku_compareAtPrice_valid
  //   ProductSku_inventory_non_negative
  //   ProductSku_priceInclTax_positive
  //   ProductSku_productId_isDefault_unique

  @@index([productId])
}

enum StockMovementSource {
  MANUAL_ADJUST
  SKU_UPDATE
  ORDER
  WEBHOOK
}

model StockMovement {
  id String @id @default(cuid(2))

  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  productId String

  previousInventory Int
  newInventory      Int
  delta             Int

  reason String? @db.VarChar(500)

  source StockMovementSource @default(MANUAL_ADJUST)

  createdById   String?
  createdByName String? @db.VarChar(100)

  createdAt DateTime @default(now())

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   StockMovement_delta_consistent
  //   StockMovement_inventory_non_negative

  @@index([skuId, createdAt(sort: Desc)])
}

model SkuMedia {
  id    String     @id @default(cuid(2))
  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  url          String    @db.VarChar(2048)
  thumbnailUrl String?   @db.VarChar(2048)
  blurDataUrl  String?   @db.Text
  altText      String?   @db.VarChar(255)
  mediaType    MediaType @default(IMAGE)
  isPrimary    Boolean   @default(false)
  position     Int       @default(0)

  width  Int?
  height Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   SkuMedia_dimensions_positive
  //   SkuMedia_one_primary_per_sku

  @@index([skuId, position])
  @@index([skuId, isPrimary])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum OrderAction {
  CREATED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  STATUS_REVERTED
  TRACKING_UPDATED
  ADDRESS_UPDATED
  INVOICE_GENERATED
  INVOICE_GENERATION_FAILED
  REFUND_CREATED
  REFUND_COMPLETED
  REFUND_FAILED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  INVOICE_VOIDED
  INVOICE_ARCHIVED
  PDF_ARCHIVE_FAILED
  CREDIT_NOTE_FAILED
  CREDIT_NOTE_GENERATED
  CREDIT_NOTE_ARCHIVED
  INVOICE_RECONCILED
  INVOICE_DOWNLOADED
  BULK_EXPORT
}

enum InvoiceStatus {
  PENDING
  GENERATED
  VOIDED
}

enum VatRegime {
  FRANCHISE_BASE
  NORMAL
  SIMPLIFIE
}

enum PaymentMethod {
  CARD
  SEPA_DEBIT
  KLARNA
  LINK
  WALLET
  BANCONTACT
  OTHER
}

model Order {
  id          String  @id @default(cuid(2))
  orderNumber String  @unique @db.VarChar(50)
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  stripePaymentIntentId String? @unique
  stripeChargeId        String? @unique

  customerEmail String @db.VarChar(255)
  customerName  String @db.VarChar(100)

  shippingFirstName  String  @db.VarChar(50)
  shippingLastName   String  @db.VarChar(50)
  shippingAddress1   String  @db.VarChar(255)
  shippingAddress2   String? @db.VarChar(255)
  shippingPostalCode String  @db.VarChar(10)
  shippingCity       String  @db.VarChar(100)
  shippingCountry    String  @default("FR") @db.VarChar(2)
  shippingPhone      String  @db.VarChar(20)

  subtotal       Int
  discountAmount Int    @default(0)
  shippingCost   Int    @default(0)
  total          Int
  currency       String @default("EUR") @db.VarChar(3)

  invoiceNumber      String?        @unique @db.VarChar(30)
  invoiceStatus      InvoiceStatus?
  invoiceGeneratedAt DateTime?
  invoiceVoidedAt    DateTime?

  creditNoteNumber      String?   @unique @db.VarChar(30)
  creditNoteGeneratedAt DateTime?
  creditNotePdfUrl      String?   @db.VarChar(2048)
  creditNotePdfHash     String?   @db.VarChar(64)

  invoicePdfUrl  String? @db.VarChar(2048)
  invoicePdfHash String? @db.VarChar(64)

  invoiceDataSnapshot Json?
  invoiceDataHash     String? @db.VarChar(64)

  vendorLegalName String?    @db.VarChar(255)
  vendorTradeName String?    @db.VarChar(255)
  vendorAddress   String?    @db.VarChar(500)
  vendorSiren     String?    @db.VarChar(9)
  vendorSiret     String?    @db.VarChar(14)
  vendorVatNumber String?    @db.VarChar(15)
  vendorEmail     String?    @db.VarChar(255)
  vendorApeCode   String?    @db.VarChar(10)
  vendorBankIban  String?    @db.VarChar(34)
  vendorBankBic   String?    @db.VarChar(11)
  vendorVatRegime VatRegime?
  vendorLegalForm String?    @db.VarChar(100)

  shippingCarrier   String?   @db.VarChar(30)
  trackingNumber    String?   @db.VarChar(50)
  trackingUrl       String?   @db.VarChar(2048)
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  shippedAt         DateTime?

  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  paymentMethod PaymentMethod @default(CARD)
  paidAt        DateTime?

  items          OrderItem[]
  discountUsages DiscountUsage[]
  refunds        Refund[]
  notes          OrderNote[]
  history        OrderHistory[]

  invoiceRetryDeferred     Boolean @default(false)
  invoiceReconcileAttempts Int     @default(0)

  overbilledAmountCents Int?
  overbillingResolvedAt DateTime?

  piiPurgedAt DateTime?

  pdfIntegrityCheckedAt DateTime?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   Order_creditNoteNumber_cross_unique
  //   Order_creditNoteNumber_format_check
  //   Order_creditNotePdfHash_format_check
  //   Order_currency_eur_check
  //   Order_customerEmail_unaccent_trgm_idx
  //   Order_customerName_unaccent_trgm_idx
  //   Order_discountAmount_non_negative
  //   Order_invoiceDataHash_format_check
  //   Order_invoiceDataSnapshot_hash_coherence_check
  //   Order_invoiceNumber_format
  //   Order_invoicePdfHash_format_check
  //   Order_invoiceReconcileAttempts_check
  //   Order_overbilledAmountCents_positive_check
  //   Order_paid_requires_paidAt
  //   Order_paid_requires_stripe_proof
  //   Order_shippingCost_non_negative
  //   Order_subtotal_non_negative
  //   Order_total_formula
  //   Order_total_non_negative
  //   Order_vendorApeCode_format_check
  //   Order_vendorBankBic_format_check
  //   Order_vendorBankIban_format_check
  //   Order_vendorSiren_format_check
  //   Order_vendorSiret_format_check
  //   Order_vendorVatNumber_format_check

  @@index([customerEmail])
  @@index([paymentStatus, createdAt])
  @@index([paidAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentStatus, deletedAt, paidAt(sort: Desc)])
  @@index([invoiceStatus])
  @@index([invoiceRetryDeferred, paidAt], map: "Order_invoiceRetryDeferred_idx")
  @@index([piiPurgedAt, paidAt], map: "Order_piiPurgedAt_paidAt_idx")
  @@index([piiPurgedAt, paidAt, createdAt], map: "Order_unpaid_pii_purge_idx")
  @@index([overbillingResolvedAt, overbilledAmountCents], map: "Order_overbilling_unresolved_idx")
}

model OrderHistory {
  id      String  @id @default(cuid(2))
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  action OrderAction

  previousStatus            OrderStatus?
  newStatus                 OrderStatus?
  previousPaymentStatus     PaymentStatus?
  newPaymentStatus          PaymentStatus?
  previousFulfillmentStatus FulfillmentStatus?
  newFulfillmentStatus      FulfillmentStatus?

  note String? @db.Text

  metadata Json?

  authorId   String?
  authorName String? @db.VarChar(100)

  source HistorySource @default(ADMIN)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt(sort: Desc)])
  @@index([authorId])
}

model OrderItem {
  id      String @id @default(cuid(2))
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  productTitle       String  @db.VarChar(200)
  productDescription String? @db.Text
  productImageUrl    String? @db.VarChar(2048)

  skuSku        String? @db.VarChar(100)
  skuColor      String? @db.VarChar(100)
  skuColorHexes String? @db.VarChar(200)
  skuMaterial   String? @db.VarChar(100)
  skuSize       String? @db.VarChar(50)
  skuImageUrl   String? @db.VarChar(2048)

  price    Int
  quantity Int

  refundItems RefundItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   OrderItem_price_positive
  //   OrderItem_quantity_positive

  @@index([orderId])
  @@index([skuId])
  @@index([productId])
}

model OrderNote {
  id String @id @default(cuid(2))

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  content String @db.Text

  authorId   String
  authorName String @db.VarChar(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId, createdAt(sort: Desc)])
}

enum RefundReason {
  CUSTOMER_REQUEST
  DEFECTIVE
  FRAUD
  OTHER
}

enum RefundStatus {
  PENDING
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

model Refund {
  id String @id @default(cuid(2))

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  stripeRefundId String? @unique

  amount   Int
  currency String @default("EUR") @db.VarChar(3)

  reason        RefundReason
  status        RefundStatus @default(PENDING)
  failureReason String?      @db.VarChar(500)

  note String? @db.Text

  items RefundItem[]

  // Pas de `createdBy` : les remboursements sont Stripe-first (Lot 2 S3.3), la
  // colonne n'avait plus aucun lecteur. La trace « qui a déclenché » vit dans
  // `OrderHistory.authorId`, écrit par les mêmes actions.
  processedAt DateTime?

  attemptCount Int @default(0)

  confirmationEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditNoteNumber      String?   @unique @db.VarChar(30)
  creditNoteGeneratedAt DateTime?
  creditNotePdfUrl      String?   @db.VarChar(2048)
  creditNotePdfHash     String?   @db.VarChar(64)

  pdfIntegrityCheckedAt DateTime?

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   Refund_amount_positive
  //   Refund_creditNoteNumber_cross_unique
  //   Refund_creditNoteNumber_format_check
  //   Refund_creditNotePdfHash_format_check
  //   Refund_currency_eur_check

  @@index([orderId])
  @@index([status, processedAt])
  @@index([status, stripeRefundId])
  @@index([createdAt(sort: Desc)])
}

model RefundItem {
  id String @id @default(cuid(2))

  refundId String
  refund   Refund @relation(fields: [refundId], references: [id], onDelete: Restrict)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  quantity Int

  amount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   RefundItem_amount_positive
  //   RefundItem_quantity_positive

  @@index([refundId])
  @@index([orderItemId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Discount {
  id   String @id @default(cuid(2))
  code String @unique @db.VarChar(30)

  type  DiscountType
  value Int

  minOrderAmount  Int?
  maxUsageCount   Int?
  maxUsagePerUser Int?

  // Pas de `startsAt` : un code promo est actif dès sa création, et se ferme
  // soit à `endsAt`, soit au toggle `isActive`. La planification à l'avance
  // exigeait un cron (`process-scheduled-discounts`, supprimé) — l'activation
  // différée est donc devenue manuelle.
  endsAt DateTime?

  usageCount Int @default(0)

  isActive Boolean @default(true)

  usages DiscountUsage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   Discount_maxUsagePerUser_positive
  //   Discount_minOrderAmount_positive
  //   Discount_percentage_max_100
  //   Discount_usageCount_non_negative
  //   Discount_usageCount_within_limit
  //   Discount_value_positive
}

model DiscountUsage {
  id         String   @id @default(cuid(2))
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  discountCode String @db.VarChar(30)

  amountApplied Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([discountId, orderId])
  @@index([orderId])
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model WebhookEvent {
  id            String             @id @default(cuid(2))
  stripeEventId String             @unique
  eventType     String             @db.VarChar(100)
  status        WebhookEventStatus @default(PENDING)
  errorMessage  String?            @db.Text
  attempts      Int                @default(0)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?

  processingStartedAt DateTime?

  @@index([status, processedAt])
  @@index([status, receivedAt])
  @@index([status, attempts, processedAt])
}

model StoreSettings {
  id             String    @id @default("store-settings-singleton")
  isClosed       Boolean   @default(false)
  closureMessage String?   @db.VarChar(500)
  closedAt       DateTime?
  reopensAt      DateTime?
  closedBy       String?   @db.VarChar(255)

  orphanMediaScanOffset Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gardes DB (SSOT `prisma/sql/raw-guards.sql`) :
  //   StoreSettings_singleton_id
}
