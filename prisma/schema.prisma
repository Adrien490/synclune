// ============================================================================
// CONFIGURATION
// ============================================================================

generator client {
  provider      = "prisma-client"
  output        = "../app/generated/prisma"
  compilerBuild = "small" // Optimized bundle for Vercel serverless
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTH & USERS
// ============================================================================

enum Role {
  USER
  ADMIN
}

// === STATUT DE COMPTE (RGPD) ===
enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING_DELETION
  ANONYMIZED
}

// === TYPE DE CLIENT (facturation electronique 2026-2027) ===
//
// Distingue B2C (particulier), B2B (entreprise) et B2G (entite publique
// via Chorus Pro). Les champs `companyName`/`companySiren`/etc. ne sont
// requis (validation applicative) que quand customerType != B2C.
enum CustomerType {
  B2C
  B2B
  B2G
}

model User {
  id               String    @id @default(cuid())
  role             Role      @default(USER)
  name             String?   @db.VarChar(100)
  email            String    @unique @db.VarChar(255)
  emailVerified    Boolean   @default(false)
  image            String?   @db.VarChar(2048)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  suspendedAt      DateTime? // Date de suspension du compte

  // === STATUT DE COMPTE (RGPD) ===
  accountStatus AccountStatus @default(ACTIVE)

  // === CONSENTEMENT RGPD ===
  termsAcceptedAt DateTime? // Date d'acceptation CGV + politique de confidentialite

  // === ANONYMISATION RGPD ===
  anonymizedAt        DateTime? // Date d'anonymisation effective
  deletionRequestedAt DateTime? // Demande de suppression enregistree

  // === FACTURATION ELECTRONIQUE (2026-2027) ===
  //
  // Toutes les valeurs sont stockees normalisees (chiffres pour SIREN/SIRET, sans
  // espaces). La validation applicative impose ces champs quand customerType !=
  // B2C. Les CHECK constraints en migration garantissent le format au niveau DB.
  customerType     CustomerType @default(B2C)
  companyName      String?      @db.VarChar(255)
  companySiren     String?      @db.VarChar(9)
  companySiret     String?      @db.VarChar(14)
  companyVatNumber String?      @db.VarChar(15) // Format intra-UE: ISO 3166-1 alpha-2 + 11 chars (FR: FR + 2 + 9 digits)

  // === ROUTING PDP CLIENT (Annuaire central facturation electronique - reforme 2026-2027) ===
  //
  // Cache local des resolutions annuaire DGFiP. Refresh par cron mensuel ou au
  // checkout si TTL expire. directoryLastCheckedSiretSnapshot fige le SIRET au
  // moment du lookup — si l'user change de SIRET, on invalide automatiquement
  // le cache. Snapshote au checkout vers Order.customerEInvoicing* (immuable
  // post-paiement).
  customerEInvoicingPlatformId      String?   @db.VarChar(100)
  customerEInvoicingAddress         String?   @db.VarChar(255)
  directoryLastCheckedAt            DateTime?
  directoryLastCheckedSiretSnapshot String?   @db.VarChar(14)

  sessions       Session[]
  accounts       Account[]
  orders         Order[]
  cart           Cart?
  addresses      Address[]
  wishlist       Wishlist?
  discountUsages DiscountUsage[]

  // Relations avec les remboursements (audit)
  refundsCreated Refund[] @relation("RefundCreator")

  // Avis produits
  reviews ProductReview[]

  @@index([accountStatus, deletionRequestedAt]) // process-account-deletions cron
  @@index([role, deletedAt]) // admin count guard + listing role filter
  @@index([deletedAt, suspendedAt]) // admin listing soft-delete + suspension filter
  @@index([customerType, deletedAt]) // admin listing B2B/B2G filter (futur)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId, expiresAt]) // Couvre aussi userId seul
  @@index([expiresAt]) // cleanup-sessions cron: WHERE expiresAt < now()
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
  @@index([accessTokenExpiresAt]) // cleanup-sessions cron: expired OAuth tokens
  @@index([refreshTokenExpiresAt]) // cleanup-sessions cron: expired refresh tokens
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.VarChar(500)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt]) // cleanup-sessions cron: WHERE expiresAt < now()
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String  @db.VarChar(50)
  lastName   String  @db.VarChar(50)
  address1   String  @db.VarChar(255)
  address2   String? @db.VarChar(255)
  postalCode String  @db.VarChar(10)
  city       String  @db.VarChar(100)
  country    String  @default("FR") @db.VarChar(2)
  phone      String  @db.VarChar(20)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Note: Contrainte unique partielle ajoutee via migration SQL brute
  // pour garantir qu'un seul enregistrement a isDefault: true par userId

  @@index([userId, isDefault]) // Couvre aussi userId seul
}

// ============================================================================
// CATALOGUE - ENUMS
// ============================================================================

enum ProductStatus {
  DRAFT
  PUBLIC
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  PUBLIC
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Statut de moderation des avis produits
enum ReviewStatus {
  PUBLISHED // Auto-publie (defaut)
  HIDDEN // Masque par moderation (spam, inapproprie, etc.)
}

// ============================================================================
// CATALOGUE - ENUMS ADDITIONNELS
// ============================================================================

/// Source d'une action sur une commande (audit trail)
enum HistorySource {
  ADMIN
  WEBHOOK
  SYSTEM
  CUSTOMER
}

// ============================================================================
// CATALOGUE - REFERENTIELS
// ============================================================================

model ProductType {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String  @unique @db.VarChar(50)
  description String? @db.Text
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false) // Types systeme non modifiables/supprimables

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Color {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String            @unique @db.VarChar(100)
  hex         String            @db.VarChar(7)
  description String?           @db.Text // Notes créatrice (or rose 18K mat, hypoallergénique, etc.)
  isActive    Boolean           @default(true) // Coherence avec Material
  skuColors   ProductSkuColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Material {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String               @unique @db.VarChar(100)
  description  String?              @db.Text
  isActive     Boolean              @default(true)
  skuMaterials ProductSkuMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Filtre fréquent sur getMaterialOptions (where isActive: true) + listing admin
  @@index([isActive])
}

/// Table de jointure explicite ProductSku <-> Color (many-to-many)
/// Permet à une variante d'être composée de plusieurs couleurs (bague bicolore
/// or rose + argent, dégradé tricolore, etc.).
/// L'ordre (`position`) reflète la priorité : position=0 = couleur principale
/// (utilisée pour vignette listing/PDP, snapshot OrderItem joint dans l'ordre).
model ProductSkuColor {
  id      String     @id @default(cuid())
  skuId   String
  sku     ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  colorId String
  // onDelete: Restrict — préserve la protection anti-orphans (parité matériaux)
  color   Color      @relation(fields: [colorId], references: [id], onDelete: Restrict)

  position Int      @default(0)
  addedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, colorId])
  @@index([colorId]) // FK reverse lookup (filtre storefront + merge-colors)
  @@index([skuId, position]) // récupération ordonnée des couleurs d'un SKU
}

/// Table de jointure explicite ProductSku <-> Material (many-to-many)
/// Permet à une variante d'être composée de plusieurs matériaux.
/// L'ordre (`position`) reflète la priorité : position=0 = matériau principal
/// (utilisé pour SEO/care-tips, snapshot OrderItem joint dans l'ordre).
model ProductSkuMaterial {
  id         String     @id @default(cuid())
  skuId      String
  sku        ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  materialId String
  // onDelete: Restrict — préserve la protection anti-orphans (audit 2026-05-11 P1.1)
  material   Material   @relation(fields: [materialId], references: [id], onDelete: Restrict)

  position Int      @default(0)
  addedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, materialId])
  @@index([materialId]) // FK reverse lookup (filtre storefront + merge-materials)
  @@index([skuId, position]) // récupération ordonnée des matériaux d'un SKU
}

// ============================================================================
// CATALOGUE - COLLECTIONS
// ============================================================================

model Collection {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(100)
  slug        String           @unique
  description String?          @db.Text
  status      CollectionStatus @default(DRAFT)

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductCollection[]

  // Used by getPublicCollectionSlugs (status = PUBLIC),
  // getCollectionOptions (status IN [DRAFT, PUBLIC]),
  // getCollectionCountsByStatus (groupBy status), and storefront/sitemap filters.
  @@index([status])
}

/// Table de jointure explicite Product <-> Collection (many-to-many)
/// Permet a un produit d'appartenir a plusieurs collections
model ProductCollection {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  /// Date d'ajout a la collection (pour tri automatique par nouveautes)
  addedAt DateTime @default(now())

  /// Produit mis en avant dans la collection (pour hero/banner)
  /// Contrainte DB: un seul produit featured par collection
  /// Index unique partiel via migration 20260417 (WHERE "isFeatured" = true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un produit ne peut appartenir qu'une seule fois a une collection
  @@unique([productId, collectionId])
  @@index([collectionId]) // FK reverse lookup
}

// ============================================================================
// CATALOGUE - PRODUITS & SKUs
// ============================================================================

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String        @db.VarChar(200)
  description String?       @db.Text
  status      ProductStatus @default(PUBLIC)

  type   ProductType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeId String?

  collections ProductCollection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete pour preserver historique commandes

  skus       ProductSku[]
  orderItems OrderItem[]

  // Avis produits
  reviews     ProductReview[]
  reviewStats ProductReviewStats?

  // Wishlist
  wishlistItems WishlistItem[]

  @@index([typeId])
  @@index([status, createdAt(sort: Desc)]) // Admin: filtrage catalogue par statut
  @@index([status, deletedAt]) // hard-delete-retention cron (soft-deleted ARCHIVED >= 10y)
}

model ProductSku {
  id        String  @id @default(cuid())
  sku       String  @unique @db.VarChar(100)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Couleurs multi (M2M via ProductSkuColor). Un SKU peut être composé de
  // plusieurs couleurs (ex: bague bicolore or rose + argent). Ordre = priorité,
  // la 1re (position=0) est la couleur « principale » utilisée pour la vignette
  // listing/PDP et le snapshot OrderItem.
  // Cap applicatif : ARRAY_LIMITS.SKU_COLORS (3).
  colors ProductSkuColor[]

  // Matériaux multi (M2M via ProductSkuMaterial). Un SKU peut être composé de
  // plusieurs matériaux (ex: bague verre + acier). Ordre = priorité, le 1er
  // (position=0) est le matériau « principal » utilisé pour SEO/care-tips.
  // Cap applicatif : ARRAY_LIMITS.SKU_MATERIALS (3).
  materials ProductSkuMaterial[]

  size String? @db.VarChar(50)

  // ATTENTION: Nom legacy trompeur. Il s'agit du PRIX FINAL paye par le client (en centimes).
  // En micro-entreprise (art. 293 B CGI), aucune TVA n'est ajoutee : prix affiche = prix paye.
  // Si bascule au regime reel TVA un jour, ce champ restera le prix final TTC (TVA incluse).
  // Exemple : 30 euros = 3000 centimes
  priceInclTax   Int
  compareAtPrice Int? // Prix avant reduction (optionnel, pour afficher prix barre)
  inventory      Int     @default(0)
  isActive       Boolean @default(true)

  isDefault Boolean @default(false)

  images     SkuMedia[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime? // Soft delete pour preserver historique commandes

  // Index FK explicite : couvre les lookups par produit y compris SKU soft-deleted.
  // Les index uniques partiels ci-dessous (WHERE "deletedAt" IS NULL) ne couvrent
  // productId en prefixe que pour les lignes actives.
  @@index([productId])

  // Garantir unicite des combinaisons produit/taille (actifs uniquement)
  // Index unique partiel gere via migration SQL brute (WHERE "deletedAt" IS NULL).
  // Note 2026-05-15 : couleur retirée de l'index suite à la migration M2M
  // ProductSkuColor (un SKU peut avoir plusieurs couleurs ; la « variant identity »
  // active se réduit à productId × size, comme pour les matériaux).
  // Permet de recréer un SKU soft-deleted avec la même taille.
  //
  // Contrainte DB: un seul SKU par defaut par produit (active SKUs uniquement)
  // Index unique partiel via migration 20260417 (WHERE "isDefault" = true AND "deletedAt" IS NULL)
  //
  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   ProductSku_inventory_non_negative      CHECK (inventory >= 0)
  //   ProductSku_priceInclTax_positive       CHECK ("priceInclTax" > 0)
}

model SkuMedia {
  id    String     @id @default(cuid())
  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  url          String    @db.VarChar(2048)
  thumbnailUrl String?   @db.VarChar(2048) // Thumbnail pour videos (poster)
  blurDataUrl  String?   @db.Text // ThumbHash base64 placeholder (~35-50 chars)
  altText      String?   @db.VarChar(255)
  mediaType    MediaType @default(IMAGE)
  isPrimary    Boolean   @default(false)
  position     Int       @default(0) // Position pour ordre d'affichage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skuId, position])
  @@index([skuId, isPrimary])
}

// ============================================================================
// PANIER
// ============================================================================

enum CartFulfillmentType {
  SHIPPING // Livraison domicile (defaut)
  CLICK_AND_COLLECT // Retrait boutique
}

model Cart {
  id String @id @default(cuid())

  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? @unique

  expiresAt DateTime?

  // Abandoned cart recovery
  abandonedEmailSentAt DateTime? // Date d'envoi de l'email de relance panier abandonne

  // === GUEST CONTACT INFO (abandoned-cart recovery for non-authenticated users) ===
  guestEmail       String?   @db.VarChar(255) // Email guest pour recovery (RGPD: consent requis)
  guestPhone       String?   @db.VarChar(30) // Optionnel, pour SMS future
  marketingConsent Boolean   @default(false) // Consentement RGPD pour emails marketing
  guestContactAt   DateTime? // Timestamp capture contact (audit RGPD)

  // === DISCOUNT CODE APPLIED (pre-checkout) ===
  appliedDiscountCode String? @db.VarChar(30) // Code promo applique au panier
  discountAmountCache Int? // Montant reduction snapshot (centimes, calcule a application)

  // === ORDER NOTES ===
  notes String? @db.VarChar(500) // Instructions speciales / demandes personnalisees

  // === FULFILLMENT MODE ===
  fulfillmentType CartFulfillmentType @default(SHIPPING)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  // Note : les champs abandonedEmailSentAt / guestEmail / guestPhone / guestContactAt /
  // marketingConsent sont du scaffolding pour une future relance panier abandonne.
  // Tant qu'aucun cron de relance n'existe, aucun index dedie n'est maintenu
  // (userId a deja son index via @unique). Recreer les index composites le jour
  // ou le cron sera cable.
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  // Prix snapshot au moment de l'ajout au panier (en centimes)
  // Protege contre les changements de prix entre l'ajout et le paiement
  // Exemple: 29,99 euros = 2999 centimes
  priceAtAdd Int

  // === GIFT OPTIONS ===
  giftWrap    Boolean @default(false) // Emballage cadeau
  giftMessage String? @db.VarChar(300) // Message cadeau (optionnel)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, skuId])
  @@index([skuId])

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   CartItem_quantity_positive    CHECK (quantity >= 1)
  //   CartItem_priceAtAdd_positive  CHECK ("priceAtAdd" > 0)
}

// ============================================================================
// WISHLIST (FAVORIS)
// ============================================================================

model Wishlist {
  id String @id @default(cuid())

  // Support utilisateur connecte OU session invite
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? @unique // UUID pour sessions invite (cookie httpOnly)

  // Date d'expiration pour les wishlists invite (null = utilisateur connecte)
  expiresAt DateTime?

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt]) // Pour le nettoyage des wishlists expirees
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  // SetNull permet l'archivage produit sans bloquer les wishlists existantes
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Back-in-stock notification
  backInStockNotifiedAt DateTime? // Date d'envoi de la notification retour en stock

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un produit ne peut etre ajoute qu'une seule fois par wishlist
  // Note: Contrainte unique sur champ nullable - validation metier cote applicatif
  @@unique([wishlistId, productId])
  // [productId] seul couvert en prefixe par l'index composite ci-dessous
  @@index([productId, backInStockNotifiedAt]) // For back-in-stock notification queries
}

// ============================================================================
// COMMANDES - ENUMS
// ============================================================================

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED // Checkout session expired (no payment attempted)
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

/// Actions tracables sur les commandes (audit trail)
/// Requis pour conformite legale (Art. L123-22 Code de Commerce)
enum OrderAction {
  CREATED // Creation de la commande
  PAID // Paiement recu
  PROCESSING // Mise en preparation
  SHIPPED // Expedition
  DELIVERED // Livraison confirmee
  CANCELLED // Annulation
  RETURNED // Retour client
  STATUS_REVERTED // Retour a un statut precedent
  TRACKING_UPDATED // Mise a jour du suivi
  ADDRESS_UPDATED // Mise a jour de l'adresse de livraison
  INVOICE_GENERATED // Facture generee
  INVOICE_GENERATION_FAILED // Echec generation/archivage facture (Art. 286 CGI - silent failure audit)
  REFUND_CREATED // Remboursement cree
  REFUND_COMPLETED // Remboursement confirme (Stripe)
  REFUND_FAILED // Echec du remboursement
  DISPUTE_OPENED // Litige ouvert
  DISPUTE_RESOLVED // Litige resolu
  INVOICE_VOIDED // Facture annulee (commande annulee apres facturation)
  INVOICE_ARCHIVED // PDF facture uploade sur UploadThing (snapshot immuable L102 B LPF)
  PDF_ARCHIVE_FAILED // Echec upload UploadThing du PDF facture (audit monitoring 2026-05-28)
  CREDIT_NOTE_FAILED // Echec emission avoir post-refund (intervention admin requise)
  CREDIT_NOTE_GENERATED // Avoir emis (refund partiel ou total) — distinct de INVOICE_VOIDED (full void)
  INVOICE_RECONCILED // Anomalie facture rattrapee par cron reconcile-invoices
  INVOICE_DOWNLOADED // Telechargement PDF facture (audit RGPD Art. 32 - EINV-SEC-002)
  BULK_EXPORT // Export CSV de masse (audit RGPD Art. 30 / livre de recettes - EINV-SEC-005)
  PDP_SUBMITTED // Facture deposee sur la plateforme agreee (PDP/PA)
  PDP_ACCEPTED // ACK positif de la plateforme / destinataire
  PDP_REJECTED // Rejet de la plateforme — pdpRejectionReason + pdpRejectionCode renseignes
  PDP_RETRY // Tentative de retransmission (DLQ cron)
  PDP_ABANDONED // Abandon apres retries epuises — escalade admin requise
  PDP_CANCELLED // Annulation par l'emetteur avant ACCEPTED
}

/// Statut de la facture associée à une commande
enum InvoiceStatus {
  PENDING // Facture en attente de génération
  GENERATED // Facture générée (PDF disponible)
  VOIDED // Facture annulée (commande annulée après facturation)
}

/// Régime TVA du vendeur figé au moment de l'émission de la facture.
/// Si Synclune sort de la franchise (depassement du seuil 37 500 EUR/an services en 2026),
/// les factures anterieures conservent FRANCHISE_BASE et la mention art. 293 B CGI.
enum VatRegime {
  FRANCHISE_BASE // Art. 293 B CGI (regime actuel Synclune — TVA non applicable)
  NORMAL // Regime reel normal
  SIMPLIFIE // Regime reel simplifie
}

/// Statut de transmission de la facture a la Plateforme de Dematerialisation Partenaire (PDP)
/// dans le cadre de la reforme facturation electronique B2B/B2G (emission obligatoire 2027-09-01).
/// Granularite par facture — l'agregat e-reporting B2C est trace separement via EReportingBatch.
/// Mappe sur le type TS `ProviderInvoiceStatus` (modules/invoices/types/invoice-provider.ts) :
/// PENDING_SUBMISSION→PENDING, SUBMITTED→SENT, ACCEPTED→ACCEPTED, REJECTED→REJECTED,
/// CANCELLED→CANCELLED. RETRYING/ABANDONED sont des etats d'orchestration locaux.
enum PdpTransmissionStatus {
  PENDING // En attente de transmission
  SENT // Transmise a la PDP, en attente d'ACK
  ACCEPTED // Accuse de reception positif de la PDP/destinataire
  REJECTED // Rejet de la PDP — rejectionReason rempli
  RETRYING // Tentative de retransmission en cours
  CANCELLED // Annulee par l'emetteur avant ACCEPTED (PDP supporte le rappel)
  ABANDONED // Abandon apres echecs repetes — escalade manuelle requise
}

/// Direction d'un log de transmission (sortant vers la plateforme ou entrant via webhook).
enum TransmissionDirection {
  OUTBOUND
  INBOUND
}

/// Statut d'une tentative individuelle (chaque ligne InvoiceTransmissionLog).
enum TransmissionLogStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Statut d'un webhook entrant emis par la plateforme agreee (PDP/PA).
/// Mirror de WebhookEventStatus (Stripe) — table separee pour ne pas melanger les eventTypes.
enum ProviderWebhookEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

/// Methode de paiement client. Typologie alignée sur Stripe `payment_method_details.type`
/// pour conformité e-reporting B2C (arrêté 2022-1299 §4.3, mode de règlement granulaire
/// transmis à la DGFiP). Mapping appliqué par `modules/payments/services/map-stripe-payment-method.ts`.
///
/// - CARD : carte bancaire brute (Visa, MC, CB)
/// - SEPA_DEBIT : prélèvement SEPA
/// - KLARNA : paiement différé Klarna
/// - LINK : Stripe Link (1-click checkout)
/// - WALLET : Apple Pay / Google Pay (wallets superposés à une carte)
/// - BANCONTACT : Bancontact (BE)
/// - OTHER : fallback pour types Stripe non encore mappés
enum PaymentMethod {
  CARD
  SEPA_DEBIT
  KLARNA
  LINK
  WALLET
  BANCONTACT
  OTHER
}

// ============================================================================
// COMMANDES - MODELS
// ============================================================================

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique @db.VarChar(50)
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // === IDENTIFIANTS STRIPE (CRITIQUES) ===
  stripeCheckoutSessionId String? @unique // cs_xxx
  stripePaymentIntentId   String? @unique // pi_xxx
  stripeCustomerId        String? @db.VarChar(50) // cus_xxx
  stripeInvoiceId         String? @unique // in_xxx

  // === INFORMATIONS CLIENT ===
  customerEmail String  @db.VarChar(255)
  customerName  String  @db.VarChar(100)
  customerPhone String? @db.VarChar(20)

  // === TYPE DE CLIENT - SNAPSHOT B2B/B2G (Facturation electronique 2026-2027) ===
  //
  // Fige le type de client + les identifiants entreprise au moment du checkout
  // (Art. 289 CGI - donnees obligatoires sur la facture). Un User peut basculer
  // B2C->B2B plus tard, ses commandes anterieures conservent l'identification
  // qui etait valide au moment de leur emission.
  customerType            CustomerType @default(B2C)
  customerCompanyName     String?      @db.VarChar(255)
  customerCompanySiren    String?      @db.VarChar(9)
  customerCompanySiret    String?      @db.VarChar(14)
  customerCompanyVatNumber String?     @db.VarChar(15)

  // === ROUTING PDP CLIENT (Annuaire facturation electronique - reforme 2026-2027) ===
  //
  // Adresse electronique = adresse a laquelle la PDP livre la facture (souvent
  // egale au SIRET). publicEntityCode + serviceCode = obligatoires pour B2G via
  // Chorus Pro (code service de la collectivite destinataire).
  // Snapshote au checkout (B2B/B2G) — peut etre null pour B2C.
  customerEInvoicingPlatformId String? @db.VarChar(100)
  customerEInvoicingAddress    String? @db.VarChar(255)
  customerPublicEntityCode     String? @db.VarChar(50)
  customerServiceCode          String? @db.VarChar(100)

  // === ADRESSE DE LIVRAISON (DENORMALISEE - SNAPSHOT) ===
  shippingFirstName  String  @db.VarChar(50)
  shippingLastName   String  @db.VarChar(50)
  shippingAddress1   String  @db.VarChar(255)
  shippingAddress2   String? @db.VarChar(255)
  shippingPostalCode String  @db.VarChar(10)
  shippingCity       String  @db.VarChar(100)
  shippingCountry    String  @default("FR") @db.VarChar(2)
  shippingPhone      String  @db.VarChar(20)

  // === MONTANTS (EN CENTIMES) ===
  subtotal       Int
  discountAmount Int    @default(0) // Montant total des reductions appliquees
  // Micro-entreprise: toujours 0 (exoneree TVA - art. 293 B CGI). Champ conserve pour evolutivite
  // si depassement du seuil de franchise (37 500 EUR/an services en 2026). CHECK >= 0 en DB.
  taxAmount      Int    @default(0)
  shippingCost   Int    @default(0) // Frais de livraison
  total          Int // Formule: MAX(0, subtotal - discountAmount + shippingCost)
  currency       String @default("EUR") @db.VarChar(3)

  // === ECHECS DE PAIEMENT ===
  // Stocke les codes d'erreur du dernier echec (historique complet dans WebhookEvent)
  paymentFailureCode    String? @db.VarChar(100) // Code Stripe: "card_declined", "expired_card", etc.
  paymentDeclineCode    String? @db.VarChar(100) // Code reseau detaille (Visa/MC)
  paymentFailureMessage String? @db.VarChar(500) // Message lisible pour debug

  // === FACTURATION (Conformité Article 286 CGI) ===
  invoiceNumber      String?        @unique @db.VarChar(30) // Format: F-YYYY-NNNNN (séquentiel par année)
  invoiceStatus      InvoiceStatus? // null = pas encore de facture
  invoiceGeneratedAt DateTime? // Date de première génération de la facture
  invoiceVoidedAt    DateTime? // Horodatage de passage VOIDED (avoir comptable émis - Art. 272-I CGI)

  // === AVOIR / CREDIT NOTE (Art. 272-I CGI - annulation post-facture) ===
  creditNoteNumber      String?   @unique @db.VarChar(30) // Format: A-YYYY-NNNNN (séquentiel par année)
  creditNoteGeneratedAt DateTime? // Date d'émission de l'avoir
  // Archivage PDF avoir (Art. L102 B LPF — symétrie facture). Lazy au 1er download
  // via /api/orders/[orderNumber]/credit-note, idempotent ensuite.
  creditNotePdfUrl  String? @db.VarChar(2048)
  creditNotePdfHash String? @db.VarChar(64)

  // === ARCHIVAGE PDF IMMUABLE (Art. L102 B LPF) ===
  invoicePdfUrl  String? @db.VarChar(2048) // URL UploadThing du PDF archivé (immuable bit-à-bit)
  invoicePdfHash String? @db.VarChar(64) // SHA-256 du PDF (empreinte audit fiscal)
  invoiceArchivedAt DateTime? // Horodatage d'upload UploadThing (cron archive-unarchived cible NULL)

  // === ARCHIVAGE XML STRUCTURE (Factur-X / UBL / CII — EINV-FORMAT-004) ===
  // Parallele au PDF : artifact XML transmis a la PDP (retry idempotent + audit).
  // invoiceXmlFormat : FACTURX_MINIMUM | FACTURX_BASIC | UBL_INVOICE | UBL_CREDITNOTE
  invoiceXmlUrl        String?   @db.VarChar(2048)
  invoiceXmlHash       String?   @db.VarChar(64)
  invoiceXmlFormat     String?   @db.VarChar(16)
  invoiceXmlArchivedAt DateTime?

  // === SNAPSHOT INVOICEDATA FIGÉ (Art. L102 B LPF — facture comme données) ===
  // Le PDF n'est qu'un rendu visuel. La "facture" au sens comptable EST le
  // payload InvoiceData figé au moment de l'attribution du numéro. Tout futur
  // changement de template doit pouvoir régénérer un PDF identique à partir
  // de ce snapshot (déterminisme jsPDF garanti par renderInvoicePdf).
  invoiceDataSnapshot Json?   // Payload InvoiceData complet (canonical-JSON, clés triées)
  invoiceDataHash     String? @db.VarChar(64) // SHA-256 du snapshot (audit-vérifiable)

  // === SNAPSHOT VENDEUR (Facturation electronique 2026-2027) ===
  //
  // Fige l'identite du vendeur au moment de invoiceGeneratedAt. Si SIRET, raison
  // sociale ou regime TVA changent ulterieurement (demenagement, sortie franchise
  // art. 293 B CGI, evolution forme juridique), les factures historiques restent
  // reconstituables a l'identique (Art. L102 B LPF).
  // Nullable pour compat avec les factures pre-snapshot (regeneration tombe sur
  // getVendorLegalInfo() env en fallback).
  vendorLegalName String?    @db.VarChar(255)
  vendorTradeName String?    @db.VarChar(255)
  vendorAddress   String?    @db.VarChar(500)
  vendorSiren     String?    @db.VarChar(9)
  vendorSiret     String?    @db.VarChar(14)
  vendorVatNumber String?    @db.VarChar(15)
  // Extension snapshot (EINV-FORMAT-007/008 — 2026-05-28). Drift acceptable
  // sur Order pre-migration (fallback env via getVendorLegalInfo()).
  vendorEmail    String? @db.VarChar(255)
  vendorApeCode  String? @db.VarChar(10)
  vendorBankIban String? @db.VarChar(34)
  vendorBankBic  String? @db.VarChar(11)
  vendorVatRegime VatRegime?
  vendorLegalForm String?    @db.VarChar(100)

  // === ROUTING PDP EMETTEUR (Annuaire central reforme 2026-2027) ===
  //
  // Identifiants emetteur dans l'annuaire central PDP. Stocke au moment de
  // l'emission (vs lu live depuis env) pour garantir la tracabilite a 10 ans
  // meme si la PDP du vendeur change.
  vendorEInvoicingPlatformId String? @db.VarChar(100)
  vendorEInvoicingAddress    String? @db.VarChar(255)

  // === STATUT TRANSMISSION PDP (par facture, granularite B2B/B2G) ===
  //
  // Granularite par facture vs EReportingBatch qui est un agregat journalier
  // B2C. A partir de 2027-09-01 — chaque facture B2B/B2G est transmise
  // individuellement a la PDP du client avec ACK explicite.
  pdpStatus          PdpTransmissionStatus?
  pdpTransmittedAt   DateTime?
  pdpAcceptedAt      DateTime?
  pdpRejectedAt      DateTime?
  pdpRejectionReason String?                @db.Text
  pdpProviderRef     String?                @db.VarChar(255) // ID retourne par la PDP
  pdpProviderName    String?                @db.VarChar(100) // Nom du provider (chorus-pro, pdp-xxx, local) au moment de la transmission
  pdpRejectionCode   String?                @db.VarChar(100) // Code structuré du rejet (filtré par cron DLQ pour codes récupérables)
  pdpRetryCount      Int                    @default(0)
  pdpLastRetryAt     DateTime?

  // === LIVRAISON ===
  shippingMethod    String?   @db.VarChar(20) // Type de livraison
  shippingCarrier   String?   @db.VarChar(30) // Transporteur (valeurs: colissimo, chronopost, mondial_relay, dpd, lettre_suivie, autre)
  shippingRateId    String? // ID du tarif Stripe utilise
  trackingNumber    String?   @db.VarChar(50)
  trackingUrl       String?   @db.VarChar(2048) // URL de suivi
  estimatedDelivery DateTime? // Date estimee de livraison
  actualDelivery    DateTime? // Date reelle de livraison
  shippedAt         DateTime? // Date d'expedition

  // === EMAILS POST-LIVRAISON ===
  reviewRequestSentAt  DateTime? // Date d'envoi de l'email de demande d'avis
  reviewReminderSentAt DateTime? // Date d'envoi du rappel de demande d'avis
  crossSellEmailSentAt DateTime? // Date d'envoi de l'email de cross-sell

  // === STATUTS ===
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  // === PAIEMENT ===
  paymentMethod PaymentMethod @default(CARD)
  paidAt        DateTime?

  // === RELATIONS ===
  items                  OrderItem[]
  discountUsages         DiscountUsage[]
  refunds                Refund[]
  notes                  OrderNote[]
  history                OrderHistory[] // Audit trail (conformite legale)
  disputes               Dispute[]
  eReportingTransactions EReportingTransaction[] // Phase 3 — transmission B2C DGFiP
  transmissionLogs       InvoiceTransmissionLog[] // Phase 5 — audit immuable transmissions PDP

  // === ADRESSE DE FACTURATION (DENORMALISEE - SNAPSHOT) ===
  billingSameAsShipping Boolean @default(true)
  billingFirstName      String? @db.VarChar(50)
  billingLastName       String? @db.VarChar(50)
  billingAddress1       String? @db.VarChar(255)
  billingAddress2       String? @db.VarChar(255)
  billingPostalCode     String? @db.VarChar(10)
  billingCity           String? @db.VarChar(100)
  billingCountry        String? @db.VarChar(2)
  billingPhone          String? @db.VarChar(20)

  // === DLQ FACTURE (Audit monitoring 2026-05-28 — EINV-OPS-004 / EINV-OPS-008) ===
  // Drapeau pose par ensure-invoice-number / archive-invoice-pdf / void-invoice
  // quand leur operation best-effort echoue. Consomme par cron reconcile-invoices
  // (daily) qui retente, increment invoiceReconcileAttempts, et escalade en
  // alerte admin si > 3. Reset a false apres succes.
  invoiceRetryDeferred     Boolean @default(false)
  invoiceReconcileAttempts Int     @default(0)

  // === SOFT DELETE (Conformite legale - Conservation 10 ans) ===
  // Ne JAMAIS supprimer physiquement une commande (Art. L123-22 Code de Commerce)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)]) // Espace client : "mes commandes" filtrées par statut
  @@index([customerEmail])
  @@index([stripeCustomerId])
  @@index([paymentStatus, createdAt]) // sync-async-payments cron
  @@index([fulfillmentStatus, actualDelivery, reviewRequestSentAt, deletedAt]) // review-request-emails cron
  @@index([paidAt(sort: Desc)]) // Dashboard KPIs, revenue chart, recent orders, CSV export
  @@index([status, createdAt(sort: Desc)]) // Admin: filtrage commandes par statut
  @@index([paymentStatus, deletedAt, paidAt(sort: Desc)]) // Dashboard: recent paid orders
  @@index([customerType, paidAt(sort: Desc)]) // Admin: dashboard B2B vs B2C, e-reporting B2C agregat (Phase 3)
  @@index([invoiceStatus, invoiceArchivedAt], map: "Order_invoiceStatus_invoicePdfUrl_idx") // cron archive-unarchived (filtre GENERATED + url NULL)
  @@index([pdpStatus, invoiceGeneratedAt]) // Cron retry transmission PDP (B2B/B2G — Phase 5)
  @@index([pdpStatus, pdpLastRetryAt]) // Cron retry-invoice-transmissions DLQ : WHERE pdpStatus IN (REJECTED, RETRYING) ORDER BY pdpLastRetryAt
  @@index([pdpStatus, pdpTransmittedAt]) // Cron reconcile-invoice-statuses : WHERE pdpStatus = SENT AND pdpTransmittedAt < now-24h
  @@index([invoiceRetryDeferred, paidAt], map: "Order_invoiceRetryDeferred_idx") // Cron reconcile-invoices : index partiel SQL (WHERE invoiceRetryDeferred = true)
  // Note : crossSellEmailSentAt / reviewReminderSentAt sont du scaffolding (aucun cron
  // cross-sell ni reminder n'existe). Recreer l'index composite le jour ou le cron sera cable.

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   Order_subtotal_non_negative           CHECK (subtotal >= 0)
  //   Order_total_non_negative              CHECK (total >= 0)
  //   Order_discountAmount_non_negative     CHECK ("discountAmount" >= 0)
  //   Order_shippingCost_non_negative       CHECK ("shippingCost" >= 0)
  //   Order_taxAmount_non_negative          CHECK ("taxAmount" >= 0)
  //   Order_currency_eur_check              CHECK (currency = 'EUR')
  //   Order_vendorSiren_format_check        CHECK ("vendorSiren" IS NULL OR "vendorSiren" ~ '^[0-9]{9}$')
  //   Order_vendorSiret_format_check        CHECK ("vendorSiret" IS NULL OR "vendorSiret" ~ '^[0-9]{14}$')
  //   Order_vendorVatNumber_format_check    CHECK ("vendorVatNumber" IS NULL OR "vendorVatNumber" ~ '^[A-Z]{2}[A-Z0-9]{2,13}$')
  //   Order_invoiceXmlFormat_check          CHECK ("invoiceXmlFormat" IS NULL OR "invoiceXmlFormat" IN ('FACTURX_MINIMUM', 'FACTURX_BASIC', 'UBL_INVOICE', 'UBL_CREDITNOTE'))
  //   Order_invoiceXmlHash_format_check     CHECK ("invoiceXmlHash" IS NULL OR "invoiceXmlHash" ~ '^[a-f0-9]{64}$')
}

/// Historique des actions sur les commandes (audit trail)
/// Obligatoire pour conformite legale francaise (Art. L123-22 Code de Commerce)
/// Conservation 10 ans avec la commande
/// onDelete: SetNull pour preserver l'audit trail meme si commande supprimee
model OrderHistory {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Action effectuee sur la commande
  action OrderAction

  /// Statuts avant/apres pour les changements de statut
  previousStatus            OrderStatus?
  newStatus                 OrderStatus?
  previousPaymentStatus     PaymentStatus?
  newPaymentStatus          PaymentStatus?
  previousFulfillmentStatus FulfillmentStatus?
  newFulfillmentStatus      FulfillmentStatus?

  /// Note explicative (ex: raison annulation, commentaire admin)
  note String? @db.Text

  /// Metadonnees supplementaires (JSON flexible pour donnees additionnelles)
  metadata Json?

  /// Auteur de l'action
  authorId   String? // ID de l'admin ou null pour actions systeme
  authorName String? @db.VarChar(100) // Denormalise pour audit (si admin supprime plus tard)

  /// Source de l'action
  source HistorySource @default(ADMIN)

  /// Timestamp de l'action
  createdAt DateTime @default(now())

  // === INDEXES ===
  @@index([orderId, createdAt(sort: Desc)])
  @@index([authorId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // onDelete: SetNull - Preserve l'historique des ventes, le snapshot (productTitle, etc.) reste
  // Un produit soft-deleted rend productId null sans bloquer ni cascader
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // onDelete: Restrict intentionnel - Un SKU avec commandes ne peut pas etre supprime
  // Garantit l'integrite comptable (Art. L123-22 Code de commerce - conservation 10 ans)
  // Pour "supprimer" un SKU : utiliser le soft-delete sur Product ou archiver le SKU
  skuId String
  sku   ProductSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  // Snapshot des donnees produit au moment de la commande
  productTitle       String  @db.VarChar(200)
  productDescription String? @db.Text
  productImageUrl    String? @db.VarChar(2048)

  skuSku       String? @db.VarChar(100) // Snapshot du code SKU au moment de la commande
  skuColor     String? @db.VarChar(100)
  /// Snapshot des hex codes (CSV "#B76E79,#C0C0C0", ordre = position) pour rendu pastille email/facture.
  skuColorHexes String? @db.VarChar(200)
  skuMaterial  String? @db.VarChar(100)
  skuSize      String? @db.VarChar(50)
  skuImageUrl  String? @db.VarChar(2048)

  // Prix et quantite
  price    Int // Prix unitaire FINAL sans TVA en centimes (micro-entreprise exoneree)
  quantity Int

  // === TVA PAR LIGNE (Facturation electronique 2026-2027) ===
  //
  // Champs requis pour Factur-X / UBL / CII (mapping CEFACT UNTDID BT-151
  // Item VAT category, BT-152 Item VAT rate, BT-117 Invoiced net amount).
  //
  // Defauts pour la franchise TVA actuelle (Art. 293 B CGI) :
  //   - taxRate = 0 (basis points : 2000 = 20.00%)
  //   - taxAmount = 0 (centimes)
  //   - taxCategoryCode = "ZB" (Z = zero rate, branche franchise) — voir
  //     mapping UNTDID 5305 pour les autres categories ("S" standard, "AE"
  //     autoliquidation, "E" exoneree, "G" export hors UE, "K" intra-UE)
  //   - lineTotalExcludingTax = price * quantity (backfille via migration)
  //   - lineTotalIncludingTax = price * quantity (idem pour franchise)
  //
  // Quand Synclune basculera au regime reel, les actions checkout devront
  // recalculer ces champs ligne par ligne (les valeurs ne sont PAS derivees
  // a la lecture pour garantir le snapshot Art. L102 B LPF).
  taxRate                Int     @default(0)
  taxAmount              Int     @default(0)
  lineTotalExcludingTax  Int     @default(0)
  lineTotalIncludingTax  Int     @default(0)
  taxCategoryCode        String? @db.VarChar(2)

  // === IDENTIFIANTS PRODUIT (Facturation electronique BASIC/EN 16931+) ===
  // Snapshot au checkout pour Factur-X BASIC/EN16931 (BT-156 classification
  // douaniere SH) et UBL/CII (cac:Item/cbc:CommodityClassification).
  // - hsCode   : Systeme Harmonise OMD (6 a 10 chiffres). Optionnel : a peupler
  //              uniquement si export hors UE prevu.
  // - unitCode : UN/ECE Rec 20 (H87 = piece, KGM = kg, MTR = metre). Defaut
  //              applicatif "H87" au checkout pour bijoux unitaires. NULL pour
  //              les commandes anterieures a la migration (snapshot Art. L102 B).
  hsCode   String? @db.VarChar(10)
  unitCode String? @db.VarChar(3)

  // Relations
  refundItems RefundItem[]

  // Avis produit (un OrderItem peut avoir un avis, relation 1:1)
  review ProductReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([skuId])
  @@index([productId])

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   OrderItem_price_positive     CHECK (price > 0)
  //   OrderItem_quantity_positive  CHECK (quantity > 0)
  //   OrderItem_hsCode_check       CHECK (hsCode IS NULL OR hsCode ~ '^[0-9]{6,10}$')
  //   OrderItem_unitCode_check     CHECK (unitCode IS NULL OR unitCode ~ '^[A-Z0-9]{1,3}$')
}

/// Notes internes sur les commandes (visibles uniquement par les admins)
/// Permet de documenter les echanges clients, incidents, ou actions speciales
model OrderNote {
  id String @id @default(cuid())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Contenu de la note
  content String @db.Text

  // Admin qui a cree la note
  authorId   String
  authorName String @db.VarChar(100) // Denormalise pour historique si admin supprime

  // Drapeau interne : true = visible uniquement par les admins (fraude suspectee,
  // blacklist, escalade legale, etc.). false = visible aussi cote client si jamais
  // /account/orders expose les notes. Default false pour preserver le comportement
  // historique des notes existantes.
  isInternal Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete pour audit trail

  @@index([orderId, createdAt(sort: Desc)])
  @@index([orderId, isInternal])
}

// ============================================================================
// REMBOURSEMENTS
// ============================================================================

enum RefundReason {
  CUSTOMER_REQUEST // Droit de retractation (14 jours)
  DEFECTIVE // Bijou casse / abime
  WRONG_ITEM // Erreur de preparation de commande
  LOST_IN_TRANSIT // Colis perdu par le transporteur
  FRAUD // Fraude averee
  OTHER // Autre
}

enum RefundStatus {
  PENDING // Demande recue / En attente de validation
  APPROVED // Valide, en attente de traitement Stripe
  COMPLETED // Rembourse effectivement (Stripe a confirme)
  REJECTED // Refuse (ex: retour hors delai)
  FAILED // Echec technique Stripe
  CANCELLED // Annule par l'admin (soft delete)
}

model Refund {
  id String @id @default(cuid())

  // Relation avec la commande (Restrict pour protection comptable)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Identifiant Stripe du remboursement (pour lier la compta)
  stripeRefundId String? @unique // re_xxxx

  // Montants
  amount   Int // Montant TOTAL rembourse en centimes
  currency String @default("EUR") @db.VarChar(3)

  // Raison et Statut
  reason        RefundReason
  status        RefundStatus @default(PENDING)
  failureReason String? // Detail si FAILED (ex: "insufficient_funds", "charge_already_refunded")

  // Note interne (ex: "Le fermoir etait casse, photos recues par mail")
  note String? @db.Text

  // Details des articles rembourses
  items RefundItem[]

  // Phase 3 — chaque refund COMPLETED produit une transaction e-reporting REFUND
  eReportingTransactions EReportingTransaction[]

  // Audit
  createdBy     String? // ID de l'admin qui a cree le remboursement
  createdByUser User?     @relation("RefundCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  processedAt   DateTime? // Date de traitement effectif (Stripe)

  // Nombre de tentatives Stripe (P0.2 idempotency key rotation).
  // Incremente a chaque `retryFailedRefund` pour generer une nouvelle cle
  // d'idempotence Stripe ; sinon Stripe rejoue la reponse mise en cache
  // (24h pour les erreurs 4xx). Inclus dans `idempotencyKey: refund_${id}_${attemptCount}`.
  attemptCount Int @default(0)

  // ORD-STRIPE-005 : flag DB pour dédup cross-instance de l'email confirmation
  // client. SAGA admin / webhook charge.refunded / cron reconcile-refunds peuvent
  // tous tenter d'envoyer le même email. Resend `idempotencyKey` (24h) seule ne
  // suffit pas si les 3 chemins génèrent des clés différentes (incident).
  // Posé atomiquement avant envoi → si Resend échoue, retry possible via cron.
  confirmationEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === AVOIR / CREDIT NOTE (Art. 272-I CGI - Phase 2A) ===
  //
  // Stocke le numero d'avoir par REMBOURSEMENT (vs sur Order auparavant).
  // Permet d'emettre un avoir partiel distinct pour chaque refund partiel
  // COMPLETED, sans confondre avec l'annulation totale de la facture.
  //
  // Cycle de deprecation : les champs equivalents sur Order restent
  // populates par voidInvoice() (full void path) tant que le code n'a pas
  // migre. Le backfill SQL initial copie Order.creditNoteNumber vers le
  // dernier Refund COMPLETED de la commande (idempotent).
  creditNoteNumber      String?   @unique @db.VarChar(30) // Format: A-YYYY-NNNNN
  creditNoteGeneratedAt DateTime?
  creditNotePdfUrl      String?   @db.VarChar(2048)
  creditNotePdfHash     String?   @db.VarChar(64)

  // === SOFT DELETE (Conformite legale - Conservation 10 ans) ===
  // Ne JAMAIS supprimer physiquement un remboursement (Art. L123-22 Code de Commerce)
  deletedAt DateTime?

  @@index([orderId])
  @@index([status, processedAt]) // reconcile-refunds cron
  @@index([status, stripeRefundId]) // reconcile-refunds cron (APPROVED + non-null stripeRefundId)
  @@index([createdAt(sort: Desc)]) // Admin: tri chronologique remboursements
  @@index([createdBy]) // Admin: remboursements par admin

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   Refund_amount_positive    CHECK (amount > 0)
  //   Refund_currency_eur_check CHECK (currency = 'EUR')
}

model RefundItem {
  id String @id @default(cuid())

  refundId String
  refund   Refund @relation(fields: [refundId], references: [id], onDelete: Restrict)

  // Lien precis vers la ligne de commande d'origine
  // Cela permet de savoir quel produit exact (et a quel prix d'origine) est rembourse
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  quantity Int // Nombre d'unites remboursees (ex: 1 sur 2 achetees)

  amount Int // Montant rembourse pour CET article (en centimes)
  // Permet de rembourser moins que le prix d'achat si decote appliquee

  // Gestion de stock
  restock Boolean @default(true) // Faut-il remettre le produit en stock (inventory +1) ?
  // false si le produit est abime/casse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([refundId])
  @@index([orderItemId])

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   RefundItem_quantity_positive  CHECK (quantity >= 1)
  //   RefundItem_amount_positive    CHECK (amount > 0)
}

// ============================================================================
// LITIGES STRIPE (CHARGEBACKS)
// ============================================================================

enum DisputeStatus {
  NEEDS_RESPONSE // Requires evidence submission
  UNDER_REVIEW // Evidence submitted, Stripe reviewing
  WON // Resolved in merchant's favor
  LOST // Resolved in customer's favor
  CHARGE_REFUNDED // Charge was refunded before dispute resolved
}

enum DisputeReason {
  DUPLICATE
  FRAUDULENT
  SUBSCRIPTION_CANCELED
  PRODUCT_UNACCEPTABLE
  PRODUCT_NOT_RECEIVED
  UNRECOGNIZED
  CREDIT_NOT_PROCESSED
  GENERAL
}

/// Litige Stripe (chargeback) associe a une commande
/// Permet de tracker les disputes de maniere structuree au lieu de notes texte libres
model Dispute {
  id              String @id @default(cuid())
  stripeDisputeId String @unique // dp_xxx

  // Relation avec la commande (Restrict pour protection comptable)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Montants
  amount   Int // Montant conteste en centimes
  fee      Int    @default(0) // Frais de litige Stripe (~1500 = 15 EUR)
  currency String @default("EUR") @db.VarChar(3)

  // Raison et statut
  reason DisputeReason
  status DisputeStatus @default(NEEDS_RESPONSE)

  // Deadline Stripe pour soumettre les preuves
  dueBy DateTime?

  // Resolution
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   Dispute_amount_positive     CHECK (amount > 0)
  //   Dispute_fee_non_negative    CHECK (fee >= 0)
  //   Dispute_currency_eur_check  CHECK (currency = 'EUR')
}

// ============================================================================
// CODES PROMO & REDUCTIONS
// ============================================================================

enum DiscountType {
  PERCENTAGE // Ex: -20%
  FIXED_AMOUNT // Ex: -10 euros
}

model Discount {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(30) // Ex: "BIENVENUE10", "ETE2025"

  // Type et valeur de la reduction
  type  DiscountType
  value Int // En pourcentage (20 = 20%) ou centimes (1000 = 10 euros)

  // Conditions d'utilisation
  minOrderAmount  Int? // Montant minimum de commande en centimes (ex: 5000 = 50 euros)
  maxUsageCount   Int? // Nombre max d'utilisations total (null = illimite)
  maxUsagePerUser Int? // Nombre max d'utilisations par utilisateur (null = illimite)

  // Periode de validite
  startsAt DateTime  @default(now())
  endsAt   DateTime?

  // Statistiques
  usageCount Int @default(0) // Compteur d'utilisations

  // Etat
  isActive Boolean @default(true)

  // Relations
  usages DiscountUsage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, deletedAt, startsAt, endsAt]) // Admin list + checkout active check

  // CHECK constraints (DB, SQL brut — non exprimables en Prisma) :
  //   Discount_value_positive     CHECK (value > 0)
  //   Discount_percentage_max_100 CHECK (type != 'PERCENTAGE' OR value <= 100)
}

model DiscountUsage {
  id         String   @id @default(cuid())
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)

  // Utilisateur (optionnel pour guest checkout)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Commande associee (Restrict pour protection comptable)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Snapshot du code promo utilise (le code peut etre modifie apres usage)
  discountCode String @db.VarChar(30)

  // Montant de la reduction appliquee (snapshot)
  amountApplied Int // En centimes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([discountId, orderId])
  @@index([orderId])
  @@index([discountId, userId]) // Pour verifier usage par utilisateur, couvre aussi discountId seul
  @@index([userId]) // Lookup usage par utilisateur (verification limite promo/user)
}

// ============================================================================
// AVIS PRODUITS
// ============================================================================

/// Avis produit laisse par un acheteur verifie
/// Un seul avis par utilisateur et par produit (pas par OrderItem)
/// Permet de mettre a jour l'avis apres un nouvel achat
model ProductReview {
  id String @id @default(cuid())

  // === RELATIONS PRINCIPALES ===
  // Produit concerne (relation vers Product, pas ProductSku)
  // Les avis sont au niveau produit, pas variante
  // SetNull permet l'archivage produit sans bloquer (avis conserve, productId devient null)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Auteur de l'avis (acheteur verifie)
  // SetNull pour conformite RGPD (anonymisation utilisateur possible)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Preuve d'achat : OrderItem du PREMIER achat ayant permis de laisser l'avis
  // Ce champ ne change pas lors des mises a jour de l'avis (meme si rachat ulterieur)
  // Garantit que seuls les acheteurs verifies peuvent laisser un avis
  orderItemId String    @unique // Un OrderItem ne peut generer qu'un seul avis
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  // === CONTENU DE L'AVIS ===
  rating  Int // Note de 1 a 5 etoiles (CHECK constraint DB + validation Zod cote serveur)
  title   String? @db.VarChar(150) // Titre optionnel de l'avis
  content String  @db.Text // Commentaire texte

  // === MODERATION ===
  status ReviewStatus @default(PUBLISHED) // Auto-publie, moderation a posteriori

  // === RELATIONS ===
  medias   ReviewMedia[] // Photos de l'avis (max 3)
  response ReviewResponse? // Reponse admin (unique)

  // === TIMESTAMPS ===
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete RGPD (10 ans conservation)

  // === CONTRAINTES ===
  // Un utilisateur ne peut laisser qu'un seul avis par produit
  // S'il rachete le produit, il peut modifier son avis existant
  // Note: Contrainte unique sur champs nullable - PostgreSQL permet plusieurs (NULL, NULL)
  // La validation metier est faite cote applicatif pour les avis actifs
  @@unique([userId, productId])
  // [productId] seul couvert en prefixe par l'index composite ci-dessous
  @@index([productId, status, deletedAt])
  @@index([deletedAt]) // hard-delete-retention cron (soft-deleted >= 10y, sans filtre product)

  // CHECK constraint (DB, SQL brut) : ProductReview_rating_range CHECK (rating >= 1 AND rating <= 5)
}

/// Photo jointe a un avis produit
/// Maximum 3 photos par avis (validation applicative)
model ReviewMedia {
  id       String        @id @default(cuid())
  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // === MEDIA (Pattern SkuMedia) ===
  url         String  @db.VarChar(2048) // URL UploadThing
  blurDataUrl String? @db.Text // ThumbHash base64 placeholder (~35-50 chars)
  altText     String? @db.VarChar(255) // Alt text pour accessibilite

  // Position pour ordre d'affichage (0, 1, 2)
  position Int @default(0)

  // === TIMESTAMPS ===
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === INDEXES ===
  @@index([reviewId, position])
}

/// Reponse de l'admin/marque a un avis
/// Une seule reponse possible par avis
model ReviewResponse {
  id       String        @id @default(cuid())
  reviewId String        @unique // Une seule reponse par avis
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  // === CONTENU ===
  content String @db.Text // Reponse texte de la marque

  // === AUTEUR ADMIN (Pattern OrderNote) ===
  // L'admin qui a redige la reponse
  authorId   String // ID de l'admin
  authorName String @db.VarChar(100) // Denormalise pour historique si admin supprime

  // === TIMESTAMPS ===
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete RGPD
}

/// Statistiques agregees des avis par produit
/// Table de cache pour performances (evite COUNT/AVG a chaque requete)
/// Mise a jour via trigger applicatif apres creation/modification/suppression d'avis
model ProductReviewStats {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // === STATISTIQUES AGREGEES ===
  totalCount    Int     @default(0) // Nombre total d'avis publies
  averageRating Decimal @default(0) @db.Decimal(3, 2) // Moyenne (ex: 4.75)

  // Distribution des notes (pour graphique cliquable)
  rating1Count Int @default(0) // Nombre d'avis 1 etoile
  rating2Count Int @default(0) // Nombre d'avis 2 etoiles
  rating3Count Int @default(0) // Nombre d'avis 3 etoiles
  rating4Count Int @default(0) // Nombre d'avis 4 etoiles
  rating5Count Int @default(0) // Nombre d'avis 5 etoiles

  // === TIMESTAMPS ===
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([averageRating]) // Dashboard: filter/sort products by rating

  // CHECK constraint (DB, SQL brut) :
  //   ProductReviewStats_averageRating_range CHECK ("averageRating" >= 0 AND "averageRating" <= 5)
}

// ============================================================================
// WEBHOOKS IDEMPOTENCY (Stripe)
// ============================================================================

enum WebhookEventStatus {
  PENDING // Recu, en attente de traitement
  PROCESSING // En cours de traitement
  COMPLETED // Traite avec succes
  FAILED // Echec du traitement
  SKIPPED // Ignore (type non gere ou doublon)
}

/// Evenements webhook Stripe
/// Permet l'idempotence et l'audit trail des webhooks
model WebhookEvent {
  id            String             @id @default(cuid())
  stripeEventId String             @unique // evt_xxx - Cle d'idempotence
  eventType     String             @db.VarChar(100) // checkout.session.completed, etc.
  status        WebhookEventStatus @default(PENDING)
  errorMessage  String?            @db.Text
  attempts      Int                @default(0)
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?

  // ORD-STRIPE-003 : tâches post-webhook persistées (emails + cache invalidation)
  // pour survivre à un crash de la lambda Vercel après le 200 retourné à Stripe.
  postTasks PostWebhookTask[]

  @@index([status, processedAt]) // cleanup + retry queries filter by status then processedAt
  @@index([status, receivedAt]) // cleanup SKIPPED/stale webhook events by receivedAt
  @@index([status, attempts, processedAt]) // retry-webhooks cron
}

// ============================================================================
// POST-WEBHOOK TASKS (ORD-STRIPE-003 — retry persistant)
// ============================================================================

enum PostWebhookTaskStatus {
  PENDING // Persistée, pas encore exécutée (ou en attente de retry)
  COMPLETED // Exécutée avec succès
  FAILED // Échec définitif après MAX_POST_WEBHOOK_RETRY_ATTEMPTS
}

/// Tâches déclenchées par un webhook (emails transactionnels, invalidation de cache)
/// qui doivent survivre à un crash de la lambda Vercel après le 200 retourné à Stripe.
///
/// Stripe ne re-livre PAS l'événement une fois 200 retourné. Sans persistance, un
/// crash entre `after(...)` start et email-send = email perdu sans backstop.
/// Le cron `retry-post-webhook-tasks` (toutes les 5min) repop PENDING + FAILED
/// dont `attempts < MAX_POST_WEBHOOK_RETRY_ATTEMPTS`.
model PostWebhookTask {
  id String @id @default(cuid())

  // Lien vers WebhookEvent (audit trail). SetNull pour préserver la task si
  // l'événement est nettoyé par cleanup-webhook-events.
  webhookEventId String?
  webhookEvent   WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  /// Type de tâche : "ORDER_CONFIRMATION_EMAIL", "INVALIDATE_CACHE", etc.
  /// Matche `PostWebhookTask["type"]` côté types TypeScript.
  taskType String @db.VarChar(60)

  /// Payload JSON sérialisé : soit `data` (email), soit `{ tags: string[] }` (cache).
  payload Json

  status       PostWebhookTaskStatus @default(PENDING)
  attempts     Int                   @default(0)
  errorMessage String?               @db.Text

  /// Clé d'idempotence applicative (`refund-confirm-XYZ`, `order-confirm-XYZ`).
  /// Sert à dédupliquer côté DB en plus de Resend (24h). Optionnelle pour
  /// les INVALIDATE_CACHE qui n'ont pas besoin de dédup.
  idempotencyKey String? @unique @db.VarChar(255)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, attempts, createdAt]) // cron retry-post-webhook-tasks
  @@index([status, createdAt]) // cleanup périodique
  @@index([webhookEventId]) // audit lookup
}

// ============================================================================
// PARAMETRES BOUTIQUE
// ============================================================================

/// Singleton: parametres globaux de la boutique (1 seule ligne, ID deterministe)
/// Permet de fermer temporairement le storefront (maintenance, vacances, restock)
/// Contrainte DB: CHECK (id = 'store-settings-singleton') via migration 20260417
/// Empeche techniquement toute insertion d'une 2e ligne avec un autre ID
model StoreSettings {
  id             String    @id @default("store-settings-singleton")
  isClosed       Boolean   @default(false)
  closureMessage String?   @db.VarChar(500)
  closedAt       DateTime?
  reopensAt      DateTime?
  closedBy       String?   @db.VarChar(255)

  // === ANNOUNCEMENT BAR (replaces dedicated AnnouncementBar table) ===
  announcementMessage  String?   @db.VarChar(200)
  announcementLink     String?   @db.VarChar(2048)
  announcementStartsAt DateTime?
  announcementEndsAt   DateTime?
  announcementIsActive Boolean   @default(false)

  // === FULFILLMENT GATES ===
  // Active le mode "retrait en boutique" pour le checkout. Désactivé tant que
  // l'infra logistique n'est pas opérationnelle (cf. modules/cart/actions/set-fulfillment-mode.ts).
  clickAndCollectEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// E-REPORTING B2C (Réforme facturation électronique 2026-2027)
// ============================================================================
//
// Les ventes B2C ne suivent PAS la facturation électronique structurée — elles
// alimentent l'e-reporting : transmission périodique à la DGFiP (via une PDP/
// PA) des transactions agrégées. EReportingTransaction stocke chaque vente /
// remboursement isolément ; EReportingBatch les regroupe pour transmission.
//
// Synclune émet aujourd'hui en franchise art. 293 B (TVA = 0), mais l'e-
// reporting reste obligatoire au 1ᵉʳ septembre 2027. Cf. EINV-AUDIT-004.

enum EReportingTransactionType {
  SALES // Vente B2C (Order PAID)
  REFUND // Remboursement (Refund COMPLETED, montant négatif)
  PAYMENT // Encaissement isolé (services autoliquidés, futur)
}

enum EReportingStatus {
  PENDING // Créée localement, en attente d'agrégation
  SENT // Batch transmis à la PDP/PA, en attente d'accusé DGFiP
  ACCEPTED // Acceptée par la DGFiP
  REJECTED // Rejetée (rejouer après correction)
  RETRYING // Retransmission en cours
  ABANDONED // Échec définitif (escalade admin)
}

model EReportingBatch {
  id                  String           @id @default(cuid())
  periodFrom          DateTime
  periodTo            DateTime
  status              EReportingStatus @default(PENDING)
  transactionCount    Int              @default(0)
  totalAmountIncTax   Int              @default(0) // centimes
  totalAmountExclTax  Int              @default(0)
  totalTaxAmount      Int              @default(0)
  currency            String           @default("EUR") @db.VarChar(3)
  // Identifiant retourné par la PDP/PA au dépôt. Unique pour idempotence :
  // un même batch ne peut pas être resoumis deux fois.
  providerBatchId     String?          @unique @db.VarChar(255)
  providerResponse    Json?
  sentAt              DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?          @db.Text
  retryCount          Int              @default(0)
  transactions        EReportingTransaction[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status, periodFrom]) // cron transmit-ereporting-batch
  @@index([periodFrom, periodTo]) // dashboard fiscal admin
}

model EReportingTransaction {
  id              String                    @id @default(cuid())
  // Batch d'appartenance (null tant que pas agrégé). SetNull pour conserver
  // l'historique transaction même si le batch est purgé.
  batchId         String?
  batch           EReportingBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Référence à la source — exactement l'un des deux (pas les deux).
  orderId         String?
  order           Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  refundId        String?
  refund          Refund?                   @relation(fields: [refundId], references: [id], onDelete: SetNull)

  type            EReportingTransactionType
  occurredAt      DateTime // Date d'encaissement (Order.paidAt) ou de remboursement (Refund.processedAt)
  countryCode     String                    @db.VarChar(2) // ISO 3166-1 alpha-2 du buyer
  paymentMethod   PaymentMethod
  amountIncTax    Int // centimes — négatif pour les REFUND
  amountExclTax   Int
  taxAmount       Int                       @default(0) // toujours 0 en franchise art. 293 B
  currency        String                    @default("EUR") @db.VarChar(3)
  // Snapshot complet figé : tout ce qui sera transmis à la DGFiP, immuable
  // même si l'Order/Refund mute ensuite (anonymisation RGPD, etc.).
  payloadSnapshot Json
  status          EReportingStatus          @default(PENDING)
  createdAt       DateTime                  @default(now())

  @@index([status, occurredAt]) // cron build-ereporting-batch
  @@index([batchId])
  @@index([orderId])
  @@index([refundId])
  // EINV-GLOBAL-013 : anti-doublon e-reporting. Postgres traite NULL comme
  // distinct dans un unique index, donc :
  // - SALES/PAYMENT (orderId set, refundId null) — unique sur (orderId, type)
  // - REFUND (orderId null, refundId set) — unique sur (refundId, type)
  // La CHECK constraint `EReportingTransaction_source_xor` garantit l'XOR.
  @@unique([orderId, type], name: "EReportingTransaction_orderId_type_key")
  @@unique([refundId, type], name: "EReportingTransaction_refundId_type_key")
}

// ============================================================================
// AUDIT TRANSMISSION PDP (Réforme facturation électronique 2026-2027)
// ============================================================================
//
// Chaque tentative de transmission (sortante vers la PDP/PA, ou entrante via
// webhook) laisse une trace IMMUABLE pour audit fiscal (Art. 286 CGI, Art. L102 B
// LPF — conservation 10 ans). Mirror conceptuel d'OrderHistory pour la couche
// transmission : pas de deletedAt, pas d'updatedAt, jamais d'update.
//
// onDelete: SetNull pour préserver l'audit trail si l'Order parent est purgé.

model InvoiceTransmissionLog {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Nom du provider qui a traité la transmission (chorus-pro, pdp-xxx, local).
  provider  String                @db.VarChar(100)
  direction TransmissionDirection
  status    TransmissionLogStatus
  attempt   Int                   @default(1)

  /// Numero de facture au moment de l'evenement (snapshot, immuable).
  invoiceNumber String? @db.VarChar(30)

  /// ID provider retourné par la plateforme (présent une fois SUBMITTED).
  providerInvoiceId String? @db.VarChar(255)

  /// Code structuré du rejet/erreur (filtrable par cron DLQ).
  errorCode    String? @db.VarChar(100)
  errorMessage String? @db.Text

  /// Snapshot du payload échangé (request OUTBOUND ou event INBOUND).
  /// Réutilisable pour rejeu déterministe en cas de besoin (audit fiscal).
  payloadSnapshot Json?

  occurredAt DateTime @default(now())

  @@index([orderId, occurredAt(sort: Desc)])
  @@index([status, occurredAt(sort: Desc)]) // Dashboard admin "derniers rejets"
  @@index([provider, status, occurredAt(sort: Desc)]) // Diagnostic provider-specific
}

// ============================================================================
// WEBHOOK PLATEFORME AGRÉÉE (Idempotence + audit, Phase 5)
// ============================================================================
//
// Mirror conceptuel de WebhookEvent (Stripe) mais sur une table DEDIEE :
// les eventTypes Stripe et PDP ont des espaces de noms disjoints et leurs
// invariants downstream different (Stripe = Order/Payment, PDP = transmission).
// (provider, externalEventId) @@unique garantit l'idempotence anti-rejeu.

model ProviderWebhookEvent {
  id              String                     @id @default(cuid())
  /// Identifiant provider (chorus-pro, pdp-xxx, mock). Combiné à externalEventId pour idempotence.
  provider        String                     @db.VarChar(100)
  /// Identifiant unique d'événement émis par la plateforme.
  externalEventId String                     @db.VarChar(255)
  eventType       String                     @db.VarChar(100)
  status          ProviderWebhookEventStatus @default(PENDING)
  errorMessage    String?                    @db.Text
  attempts        Int                        @default(0)
  receivedAt      DateTime                   @default(now())
  processedAt     DateTime?

  /// Snapshot du payload (signature vérifiée OK avant écriture).
  payloadSnapshot Json?

  @@unique([provider, externalEventId])
  @@index([status, processedAt])
  @@index([status, receivedAt])
  @@index([status, attempts, processedAt]) // cron retry symétrique de retry-webhooks
}
