{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"regions": ["cdg1"],
	"crons": [
		{
			"path": "/api/cron/retry-post-webhook-tasks",
			"schedule": "*/5 * * * *"
		},
		{
			"path": "/api/cron/retry-webhooks",
			"schedule": "*/30 * * * *"
		},
		{
			"path": "/api/cron/reopen-store",
			"schedule": "*/15 * * * *"
		},
		{
			"path": "/api/cron/sync-async-payments",
			"schedule": "0 */4 * * *"
		},
		{
			"path": "/api/cron/reconcile-refunds",
			"schedule": "30 */6 * * *"
		},
		{
			"path": "/api/cron/reconcile-invoices",
			"schedule": "0 2 * * *"
		},
		{
			"path": "/api/cron/alert-dispute-deadlines",
			"schedule": "0 8 * * *"
		},
		{
			"path": "/api/cron/alert-overbilled-orders",
			"schedule": "30 8 * * *"
		},
		{
			"path": "/api/cron/process-account-deletions",
			"schedule": "0 5 * * *"
		},
		{
			"path": "/api/cron/alert-stuck-orders",
			"schedule": "0 9 * * 1"
		},
		{
			"path": "/api/cron/hard-delete-retention",
			"schedule": "0 4 2 * *"
		}
	]
}
