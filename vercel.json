{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"crons": [
		{
			"path": "/api/cron/cleanup-sessions",
			"schedule": "0 3 * * *"
		},
		{
			"path": "/api/cron/sync-async-payments",
			"schedule": "0 */4 * * *"
		},
		{
			"path": "/api/cron/process-account-deletions",
			"schedule": "0 5 * * *"
		},
		{
			"path": "/api/cron/hard-delete-retention",
			"schedule": "0 4 2 * *"
		},
		{
			"path": "/api/cron/cleanup-wishlists",
			"schedule": "30 2 * * *"
		},
		{
			"path": "/api/cron/cleanup-carts",
			"schedule": "30 3 * * *"
		},
		{
			"path": "/api/cron/cleanup-webhook-events",
			"schedule": "0 3 1 * *"
		},
		{
			"path": "/api/cron/cleanup-orphan-media",
			"schedule": "0 5 3 * *"
		},
		{
			"path": "/api/cron/retry-webhooks",
			"schedule": "*/30 * * * *"
		},
		{
			"path": "/api/cron/reopen-store",
			"schedule": "*/15 * * * *"
		},
		{
			"path": "/api/cron/reconcile-refunds",
			"schedule": "30 */6 * * *"
		},
		{
			"path": "/api/cron/cleanup-pending-orders",
			"schedule": "30 4 * * *"
		},
		{
			"path": "/api/cron/alert-stuck-orders",
			"schedule": "0 9 * * 1"
		},
		{
			"path": "/api/cron/send-review-requests",
			"schedule": "0 10 * * *"
		}
	]
}
