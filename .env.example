# ==============================================
# Synclune — Variables d'environnement
# ==============================================
# Copier ce fichier vers .env.local et remplir les valeurs :
#   cp .env.example .env.local
#
# Les variables marquees (requis) feront echouer le demarrage si absentes.
# Les variables marquees (optionnel) ont des valeurs par defaut ou sont ignorees en dev.

# ========================================
# Base de donnees (requis)
# ========================================
# URL pooler Neon (PgBouncer) utilisee par l'app runtime
DATABASE_URL="postgresql://user:password@localhost:5432/synclune"

# URL Neon directe (sans PgBouncer) — requise pour `prisma migrate deploy`
# en prod. PgBouncer rejette les prepared statements DDL.
# DATABASE_URL_UNPOOLED="postgresql://user:password@db.neon.tech/synclune"

# URL DB de tests d'integration (jamais pointer sur la prod — le client check
# qu'elle ne contient pas "prod"/"production"). Optionnel, skip silencieux si absent.
# INTEGRATION_DATABASE_URL="postgresql://user:password@localhost:5432/synclune_test"

# Base JETABLE et VIDE que `prisma migrate dev` rejoue avant de differ (shadow DB).
# Sans elle, `migrate dev` echoue en P3006 sur un endpoint Neon poole — c'est la cause
# racine de l'historique de migrations qui a du etre baseline en 0_init. Prisma DROP et
# recree son schema a chaque run : ne JAMAIS y pointer une base avec des donnees.
# Optionnel (`migrate deploy` n'en a pas besoin).
# SHADOW_DATABASE_URL="postgresql://user:password@db.neon.tech/synclune_shadow"

# ========================================
# Authentification — Better Auth (requis)
# ========================================
# Connexion réservée à l'administration : pas d'inscription (disableSignUp) et
# plus de provider OAuth (Google était un chemin d'inscription à part entière).
BETTER_AUTH_SECRET="generate-a-random-string-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# ========================================
# Email — Resend (requis)
# ========================================
RESEND_API_KEY="re_your_api_key_here"
RESEND_CONTACT_EMAIL="contact@synclune.fr"

# Adresse BCC ajoutee automatiquement aux alertes admin critiques
# (refund failed, sequence overflow, dispute). Permet d'eviter un single
# point of failure sur l'unique boite admin. Optionnel mais recommande.
# EMAIL_ADMIN_BCC=""

# ========================================
# Paiements — Stripe (requis)
# ========================================
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"

# ========================================
# Upload — UploadThing (requis)
# ========================================
UPLOADTHING_TOKEN="your_uploadthing_token"

# Listes blanches/noires IP pour le rate limiting (optionnel, comma-separated)
# RATE_LIMIT_WHITELIST=""
# RATE_LIMIT_BLACKLIST=""

# ========================================
# Cron Jobs (requis)
# ========================================
CRON_SECRET="generate-a-random-string-of-at-least-32-characters"

# Court-circuite TOUS les crons : ils s'authentifient, bootent, puis renvoient
# `status: "skipped"` sans muter la base (garde OPS-AUDIT-006 pour les deploiements
# Preview qui partagent les credentials de prod). Ne JAMAIS definir en production —
# les purges RGPD et la DLQ facture cesseraient silencieusement de travailler.
# CRON_DRY_RUN="false"

# ========================================
# Observabilite — Sentry (optionnel mais STRONGLY recommande en prod)
# ========================================
# NEXT_PUBLIC_SENTRY_DSN absent = capture erreurs OFF (erreurs invisibles).
# SENTRY_AUTH_TOKEN absent en build = sourcemaps non uploadees (stack
# traces minifiees dans le dashboard Sentry).
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
# SENTRY_ORG="synclune"
# SENTRY_PROJECT="synclune-web"
# SENTRY_AUTH_TOKEN="sntrys_..."

# ========================================
# Healthcheck token (optionnel — sondes externes UptimeRobot/Better Stack)
# ========================================
# Si defini, /api/health?token=<value> renvoie le statut detaille sans
# session admin. Doit avoir au moins 32 caracteres.
# HEALTHCHECK_TOKEN="generate-a-random-string-of-at-least-32-characters"

# ========================================
# SEO & Verification (optionnel)
# ========================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

# ========================================
# Vendeur / Facturation Stripe (optionnel — valeurs par defaut dans le code)
# ========================================
# VENDOR_LEGAL_NAME="Synclune"
# VENDOR_TRADE_NAME="Synclune"
# VENDOR_SIRET=""
# VENDOR_SIREN=""
# VENDOR_VAT_NUMBER=""
# VENDOR_APE_CODE=""
# VENDOR_FULL_ADDRESS=""
# VENDOR_EMAIL=""
# VENDOR_INSURANCE_COMPANY=""
# VENDOR_INSURANCE_CONTACT=""
# VENDOR_INSURANCE_COVERAGE=""
# VENDOR_VAT_EXEMPTION_TEXT=""
# VENDOR_LATE_PAYMENT_PENALTY_RATE=""
# VENDOR_RECOVERY_FEE=""
# VENDOR_REGISTRY=""
# VENDOR_OPERATION_NATURE=""

# ========================================
# Reforme facturation 2026-2027 — annuaire DGFiP + Factur-X/UBL (optionnel)
# ========================================
# Snapshot vendeur fige sur Order au moment du checkout. Si vide, fallbacks
# hardcodes appliques. A renseigner imperativement avant le 1er sept 2027
# (Art. 286 CGI emission obligatoire).
# VENDOR_LEGAL_FORM="Entrepreneur individuel"
# VENDOR_VAT_REGIME="FRANCHISE_BASE"           # FRANCHISE_BASE | NORMAL | SIMPLIFIE
# VENDOR_BANK_IBAN=""                          # BT-84 EN16931 (factures B2B)
# VENDOR_BANK_BIC=""                           # BT-86 EN16931

# ========================================
# Facturation electronique (optionnel)
# ========================================
# Seuil de franchise en base TVA (article 293 B CGI), en euros.
# Synclune vend des BIENS (bijoux) → 85000 (défaut SSOT shared/constants/vat-franchise.ts).
# 37500 ne vaut QUE pour les prestations de services. Laisser vide = défaut 85000.
# Utilisé par le KPI dashboard "Seuil TVA" pour anticiper la bascule TVA. Le seuil
# MAJORÉ (93500 pour les biens) en est dérivé × 1,1 — il n'a pas sa propre variable.
# Validé par env.schema.ts : une valeur non numérique ou <= 0 fait échouer le boot
# plutôt que de retomber en silence sur 85000.
# VAT_FRANCHISE_THRESHOLD_EUR="85000"

# ========================================
# Geocoding — Geoapify (optionnel — autocomplete adresse hors France)
# ========================================
GEOAPIFY_API_KEY=""

# ========================================
# Deployment (optionnel — dates JSON-LD)
# DEPLOY_DATE : alimente dateModified sur l'Article "Atelier"
# NEXT_PUBLIC_SITE_PUBLISHED_AT : date de publication initiale du site
# ========================================
# DEPLOY_DATE="2026-03-23"
# NEXT_PUBLIC_SITE_PUBLISHED_AT="2025-01-15"

# ========================================
# Next.js (optionnel)
# ========================================
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ========================================
# E2E Tests (optionnel — uniquement pour Playwright)
# ========================================
# E2E_ADMIN_EMAIL="admin@synclune.fr"
# E2E_ADMIN_PASSWORD="password123"

# ========================================
# Seed (optionnel — configuration du script de seed)
# ========================================
# Opt-in OBLIGATOIRE pour lancer le seed (garde anti-production EINV-CASH-004 :
# le seed crée des commandes payées + factures fictives). Ne JAMAIS définir en
# production.
# SEED_ALLOW="true"
# SEED_CLEANUP="false"
# SEED_ADMIN_EMAIL="admin@synclune.fr"
# SEED_ORDER_COUNT="50"
# SEED_ORDER_PREFIX="SYN"
