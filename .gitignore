# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/documentation

# testing
/coverage
test-results/
playwright-report/
e2e/.auth/

# lighthouse
.lighthouseci/
.lh-baseline/
.lhci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
package-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Claude Code
.claude

# Mirror de la doc Stripe — regénérable par `pnpm docs:stripe` (~1,6 Mo).
# Non versionné : la doc Stripe bouge en continu, un mirror commité serait
# périmé et polluerait chaque diff. Seul l'index rédigé est suivi.
docs/stripe/*.md
!docs/stripe/INDEX.md

# Serwist
public/sw*
public/swe-worker*

# Sentry
.sentryclirc

.env*.local

# SBOM généré en CI
sbom.json
